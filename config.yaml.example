profiles:
  # Deploy a certificate renewed by acme.sh to Alibaba Cloud ESA.
  - type: esa
    caller: acme.sh
    domain: example.com
    esa:
      # If left empty, credentials fall back to ALICLOUD_ACCESS_KEY_ID and
      # ALICLOUD_ACCESS_KEY_SECRET.
      access_key_id: ""
      access_key_secret: ""
      endpoint: esa.cn-hangzhou.aliyuncs.com
      site_id: 1234567890123
      # Defaults to acme-{domain} when empty.
      cert_name: ""
      region: ""

  # Deploy a certificate renewed by lego to Tencent Cloud EdgeOne.
  - type: eo
    caller: lego
    domain: example.net
    eo:
      # If left empty, credentials fall back to TENCENTCLOUD_SECRET_ID and
      # TENCENTCLOUD_SECRET_KEY.
      secret_id: ""
      secret_key: ""
      zone_id: zone-abc123
      hosts:
        - example.net
        - www.example.net
      # Defaults to acme-{domain} when empty. A -YYYYMMDD suffix is added.
      cert_name: ""
      region: ""
      ssl_endpoint: ""
      teo_endpoint: ""
